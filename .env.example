# Тип потребителя машиночитаемых данных ЕИС — определяет способ
# аутентификации (см. docs/eis-integration-instruction-2025.pdf, разделы 4-6):
#   legal_entity      — юрлицо, аутентификация mTLS-сертификатом
#   individual_person — физлицо/ИП, аутентификация токеном
#   vsrz              — внешняя система размещения заказов (не поддерживается
#                        текущим CLI — у него другой запрос, см. soap_request.py)
EIS_CONSUMER_TYPE=legal_entity

# --- Для EIS_CONSUMER_TYPE=legal_entity ---
# Сертификат руководителя/организации и его ключ, которыми регистрировались
# в личном кабинете ЕИС (раздел "Получение доступа к сведениям") и которыми
# устанавливается mTLS-соединение с сервисом.
EIS_CLIENT_CERT=./certs/client.pem
EIS_CLIENT_KEY=./certs/client.key

# --- Для EIS_CONSUMER_TYPE=individual_person ---
# Токен, полученный в личном кабинете ЕИС (раздел "Получение токена").
EIS_INDIVIDUAL_PERSON_TOKEN=

# Код региона заказчика — первые 2 цифры КЛАДР. 77 = город Москва.
EIS_ORG_REGION=77

# Код подсистемы и тип документа (см. Приложение 1/2 инструкции).
# С 2026-09-23 — реестр ИЗВЕЩЕНИЙ (PRIZ/epNotificationEF2020, электронный
# аукцион), не контрактов: продуктовое решение — клиенту нужны закупки, в
# которых ещё можно поучаствовать, а не архив уже заключённых сделок.
# Точного кода в открытой инструкции нет (Приложение 1 отсылает к закрытому
# Альбому ТФФ ЕИС, раздел 2.9.19) — значение подобрано по косвенным намёкам
# и ПОДТВЕРЖДЕНО реальным запросом (настоящее строительное извещение с этим
# кодом получено и разобрано, см. CLAUDE.md, «Известные пробелы» → «Решено»).
# Если ЕИС когда-нибудь отвергнет значение — вернётся явный SOAP-фолт, не
# молчаливый ноль результатов.
#
# Прежнее значение (реестр КОНТРАКТОВ, уже заключённых сделок — не то, что
# нужно для мониторинга участия) было RGK/contract. Если понадобится снова
# читать контракты — эти значения по-прежнему поддержаны кодом
# (`document_to_tender()`, не `notice_document_to_tender()`), просто больше
# не используются по умолчанию.
EIS_SUBSYSTEM_TYPE=PRIZ
EIS_DOCUMENT_TYPE44=epNotificationEF2020

# Таймаут запросов к сервису, секунды.
EIS_TIMEOUT=30
