# Тип потребителя машиночитаемых данных ЕИС — определяет способ
# аутентификации (см. docs/eis-integration-instruction-2025.pdf, разделы 4-6):
#   legal_entity      — юрлицо, аутентификация mTLS-сертификатом
#   individual_person — физлицо/ИП, аутентификация токеном
#   vsrz              — внешняя система размещения заказов (не поддерживается
#                        текущим CLI — у него другой запрос, см. soap_request.py)
EIS_CONSUMER_TYPE=legal_entity

# --- Для EIS_CONSUMER_TYPE=legal_entity ---
# Сертификат руководителя/организации и его ключ, которыми регистрировались
# в личном кабинете ЕИС (раздел "Получение доступа к сведениям") и которыми
# устанавливается mTLS-соединение с сервисом.
EIS_CLIENT_CERT=./certs/client.pem
EIS_CLIENT_KEY=./certs/client.key

# --- Для EIS_CONSUMER_TYPE=individual_person ---
# Токен, полученный в личном кабинете ЕИС (раздел "Получение токена").
EIS_INDIVIDUAL_PERSON_TOKEN=

# Код региона заказчика — первые 2 цифры КЛАДР. 77 = город Москва.
EIS_ORG_REGION=77

# Код подсистемы и тип документа (см. Приложение 1/2 инструкции).
# ВНИМАНИЕ: значения по умолчанию ниже — из примера в официальной инструкции
# (реестр контрактов), а не подтверждённый код для "предстоящих закупок"
# (извещений). Для мониторинга закупок для участия, а не уже заключённых
# контрактов, нужно уточнить точный subsystemType/documentType44 для реестра
# извещений по Альбому ТФФ ЕИС (раздел 2.9.19, не входит в общедоступную
# инструкцию) — это можно узнать через getNsiRequest("nsiAllList") в личном
# кабинете или у поддержки ЕИС.
EIS_SUBSYSTEM_TYPE=RGK
EIS_DOCUMENT_TYPE44=contract

# Таймаут запросов к сервису, секунды.
EIS_TIMEOUT=30
