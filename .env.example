# URL WSDL, который выдаётся после подписания соглашения об информационном
# взаимодействии с Федеральным казначейством (личный кабинет ЕИС -> раздел
# "Информационное взаимодействие" -> веб-сервисы).
# Пример тестового контура (адрес и путь сервиса уточняются в вашем регламенте):
EIS_WSDL_URL=https://int44.zakupki.gov.ru/eis-integration/services/getDocsIP?wsdl

# Название SOAP-операции для выгрузки реестра закупок.
# Уточняется по документации/WSDL, которые вам выдал оператор ЕИС.
EIS_OPERATION_NAME=getDocsByOrgRegion

# Клиентский сертификат для mTLS (обычно выпускается на ГОСТ-криптографии,
# см. README про КриптоПро).
EIS_CLIENT_CERT=./certs/client.pem
EIS_CLIENT_KEY=./certs/client.key
EIS_CLIENT_KEY_PASSWORD=

# Код региона (субъекта РФ) в справочнике ЕИС. 77 = город Москва.
EIS_REGION_CODE=77

# ОКПД2-коды раздела "Строительство" (можно перечислить через запятую).
EIS_OKPD2_CODES=41,42,43

# Таймаут запросов к сервису, секунды.
EIS_TIMEOUT=30
